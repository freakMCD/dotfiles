
# NeoMutt — Gruvbox Dark
# System palette: #090505 / #ebdbb2

# General
color normal            #ebdbb2 default
color indicator         #fbf1c7 #282828
color status            #ebdbb2 #1d2021
color error             #fb4934 #1f0706
color warning           #fabd2f default
color message           #83a598 default

# Index
color index             #ebdbb2 default "~A"
color index             #928374 default "~D"

# Sender
color index_author      #bdae93 default "~A"
color index_author bold #b8bb26 default "~U"
color index_author      #928374 default "~D"

# Subject
color index_subject     #ebdbb2 default "~A"
color index_subject bold #fbf1c7 default "~U"
color index_subject     #fabd2f default "~F"
color index_subject     #928374 default "~D"

# Metadata
color index_number      #928374 default
color index_date        #928374 default
color index_flags       #928374 default "~A"
color index_flags       #b8bb26 default "~U"
color index_flags       #d3869b default "~T"
color index_flags       #fb4934 default "~F"
color index_flags       #928374 default "~D"

# Status bar
color status            #b8bb26 #1d2021 '[0-9]+ new'
color status            #d3869b #1d2021 '[0-9]+ flagged'
color status            #fb4934 #1d2021 '[0-9]+ deleted'

# Pager
color attachment        #d3869b default
color signature         #928374 default
color search            #090505 #fabd2f
color tree              #928374 default
color tilde             #32302f default
color markers           #928374 default

# Headers
color hdrdefault        #928374 default
color header            #d3869b default '^From:'
color header            #bdae93 default '^To:'
color header            #83a598 default '^Subject:'
color header            #928374 default '^Date:'

# Quoted text
color quoted0           #83a598 default
color quoted1           #689d6a default
color quoted2           #b16286 default
color quoted3           #928374 default
color quoted4           #a89984 default

# Body
color body #b8bb26 default '[[:alnum:]_.%+-]+@[[:alnum:].-]+'
color body #83a598 default 'https?://[^[:space:]<>]+'

# Sidebar
color sidebar_ordinary  #bdae93 default
color sidebar_new       #b8bb26 default
color sidebar_unread    #98971a default
color sidebar_flagged   #fb4934 default
color sidebar_indicator #fbf1c7 #282828
color sidebar_divider   #32302f default

