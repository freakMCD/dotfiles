set color_directcolor=yes
source ~/.config/neomutt/colors
source ~/.config/neomutt/mappings

set from = "Edwin Velarde <vastagox@gmail.com>"
set timeout = 300
timeout-hook 'exec sync-mailbox'

# paths
set folder = "~/.local/share/email/gmail"
set header_cache = "~/.cache/mutt/gmail/header_cache"
set mailcap_path="~/.config/neomutt/mailcap"

# mailbox settings
set mbox_type = Maildir
set spool_file = +INBOX
set postponed = +Drafts
set trash= +[Gmail].Papelera
unset record
mailboxes +INBOX +Github +Interbank

## Generic
set use_threads=yes sort=reverse-last-date sort_aux=reverse-date
set pager_stop
set tilde

# Set preffered view modes
alternative_order text/plain text/enriched text/html

# Number | Flags | Sender | Subject | Date
set index_format = "%3C %Z %-20.20L  %s%*  %<[d?%[%H:%M]&%<[y?%[%b %d]&%[%d/%m/%y]>>"

# ── Status bar ───────────────────────────────────

set status_format = " %R %D  │  %M messages%<u?  ·  %u unread>%<f?  ·  %f flagged>%<d?  ·  %d deleted>%<t?  ·  %t tagged>%<p?  ·  %p postponed>%>  %P "

set status_chars = " *%A"

# ── Interface ────────────────────────────────────

unset help
unset wait_key
unset markers

