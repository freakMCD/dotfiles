#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/share/linuxfedora"

config="$HOME/nix/dotfiles/neomutt/.mbsyncrc"
root="$HOME/.local/share/email/gmail"
marker=$(mktemp "${XDG_RUNTIME_DIR:?}/mailsync.XXXXXX")
trap 'rm -f "$marker"' EXIT

header() {
    sed -n "/^$1: /s/^$1: //p" "$2" |
        perl -pe 'use MIME::EncWords(decode_mimewords); $_=decode_mimewords($_);'
}

mbsync -c "$config" gmail

for folder in INBOX Github Interbank; do
    dir="$root/$folder/new"
    [[ -d "$dir" ]] || continue

    while IFS= read -r -d '' mail; do
        sender=$(header From "$mail")
        subject=$(header Subject "$mail")
        [[ -n "$sender" && -n "$subject" ]] &&
            notify-send -t 30000 "$sender" "$subject" || true
    done < <(find "$dir" -type f -newer "$marker" -print0)
done
